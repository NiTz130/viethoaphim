# MiniMax (LLM + TTS) — get an API key from https://platform.minimax.io
# Paste your real key in .env (gitignored); this file ships placeholder values only.
ANTHROPIC_API_KEY=sk-cp-REPLACE_ME

# TTS — leave blank to fall back to ANTHROPIC_API_KEY
TTS_API_KEY=

# LLM model (default MiniMax-M3)
LLM_MODEL=MiniMax-M3

# TTS model (default speech-2.8-hd; switch to speech-2.8-turbo for cheaper synthesis)
TTS_MODEL=speech-2.8-hd

# Voice ID — must be a valid MiniMax voice id (NOT a legacy edge_tts name).
# Lookup: https://platform.minimax.io/faq/system-voice-id
TTS_VOICE_ID=Vietnamese_crisp_announcer_v2

# LLM endpoint (default MiniMax Anthropic-compatible)
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic

# TTS endpoint (default MiniMax speech-2.8; engine appends /t2a_v2)
TTS_BASE_URL=https://api.minimax.io/v1

# TTS timeout (seconds; default 30s)
TTS_TIMEOUT=30.0

# STT (faster-whisper, runs locally; no API key)
STT_MODEL=medium
STT_LANGUAGE=zh

# Project working dirs
JOBS_DIR=jobs
REFERENCE_DATA_DIR=data
SAMPLE_RATE=44100
